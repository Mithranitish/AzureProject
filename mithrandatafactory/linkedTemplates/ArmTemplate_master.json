{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "mithrandatafactory"
		},
		"AzureSqlDatabaseMithran_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseMithran'"
		},
		"LS_DL_CSC_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_DL_CSC'"
		},
		"AzureSqlDatabaseMithran_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mithransqldb.database.windows.net"
		},
		"AzureSqlDatabaseMithran_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureProject"
		},
		"AzureSqlDatabaseMithran_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "usersqldb"
		},
		"LS_DL_CSC_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mithranstorageaccount.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "mithrandatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabaseMithran_password": {
						"value": "[parameters('AzureSqlDatabaseMithran_password')]"
					},
					"LS_DL_CSC_accountKey": {
						"value": "[parameters('LS_DL_CSC_accountKey')]"
					},
					"AzureSqlDatabaseMithran_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseMithran_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseMithran_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseMithran_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaseMithran_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaseMithran_properties_typeProperties_userName')]"
					},
					"LS_DL_CSC_properties_typeProperties_url": {
						"value": "[parameters('LS_DL_CSC_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}